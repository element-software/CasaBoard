{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    ".env*"
  ],
  "globalEnv": [
    "RESEND_API_KEY",
    "STRIPE_SECRET_KEY"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
